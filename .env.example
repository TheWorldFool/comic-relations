DEEPSEEK_API_KEY=
# Alternatively, point to a UTF-8 file containing only the key.
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Includes the model's reasoning budget as well as its JSON answer.
DEEPSEEK_MAX_TOKENS=32768
# low by default; a truncated request gets one fresh non-thinking retry.
DEEPSEEK_REASONING_EFFORT=low
PORT=3001
